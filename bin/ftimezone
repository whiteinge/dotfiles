#!/usr/bin/env sh
# Fuzzy-find available timezones

tzdir="${TZDIR:-/usr/share/zoneinfo}"

# Need the tzdata-legacy package on Debian.
# Pruned: the right/ (leap-second) and posix/ (duplicate) subtrees, plus the
# metadata files that are not zones at all.
find "$tzdir" \( -name posix -o -name right \) -prune -o \
    \( -type f -o -type l \) -print 2>/dev/null \
| sed "s|^${tzdir}/||" \
| grep -Ev '\.(tab|zi|list)$|(^|/)(localtime|posixrules|leapseconds|leap-seconds)$' \
| sort -u | fzy -p 'Timezone > '
